{
  "name": "codealong",
  "private": true,
  "version": "0.1.0",
  "description": "Coding tutorials that wait for you. Pauses the tutorial in Chrome while you code in VS Code.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sebastianingebrigtsen/codealong.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/protocol",
    "packages/vscode",
    "packages/chrome"
  ],
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
    "build:release": "node scripts/build.mjs --release",
    "typecheck": "tsc -p packages/protocol --noEmit && tsc -p packages/vscode --noEmit && tsc -p packages/chrome --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && vitest run --config e2e/vitest.config.ts",
    "test:vscode": "npm run build && node e2e/vscode/run.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "assets": "node scripts/assets.mjs",
    "package": "node scripts/package.mjs",
    "version:set": "node scripts/versions.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.4",
    "@types/vscode": "~1.95.0",
    "@types/ws": "^8.18.2",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.3"
  }
}
