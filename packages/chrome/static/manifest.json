{
  "manifest_version": 3,
  "name": "CodeAlong",
  "version": "0.1.0",
  "description": "Pauses your coding tutorial while you type in VS Code and resumes it when you are done.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "scripting", "activeTab", "alarms"],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://*.youtube-nocookie.com/*",
    "https://vimeo.com/*",
    "https://*.vimeo.com/*",
    "https://laracasts.com/*",
    "https://*.laracasts.com/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*",
        "https://*.youtube-nocookie.com/*",
        "https://vimeo.com/*",
        "https://*.vimeo.com/*",
        "https://laracasts.com/*",
        "https://*.laracasts.com/*"
      ],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CodeAlong",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "toggle-playback": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Pause / resume the tutorial"
    },
    "done": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "I'm done – continue the tutorial"
    }
  }
}
